{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "builder": "tsc",
    "deleteOutDir": true
  },
  "assets": [
      {
        "include": "../generated/prisma",
        "outDir": "dist/generated",
        "watchAssets": true
      }
    ]
}
